@model PendosManagementSystem.Models.Requestor
@{
    ViewData["Title"] = "Create Request";
}
<h1>Create Request</h1>
<form asp-action="Create">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="BadgeUser" class="control-label">Badge Number</label>
                <div class="input-group">
                    <input asp-for="BadgeUser" class="form-control" id="badgeInput" required />
                    <button type="button" class="btn btn-primary" id="validateBadge">Validate Badge</button>
                </div>
                <span id="badgeValidationMessage" class="text-danger"></span>
                <span asp-validation-for="BadgeUser" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Department" class="control-label"></label>
                <input asp-for="Department" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <label asp-for="RequestorEmail" class="control-label">Email</label>
                <input asp-for="RequestorEmail" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Purpose" class="control-label"></label>
                <textarea asp-for="Purpose" class="form-control" required></textarea>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EstimateBorrowStart" class="control-label">Estimated Borrow Start Date</label>
                <input asp-for="EstimateBorrowStart" type="date" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label asp-for="EstimateBorrowEnd" class="control-label">Estimated Borrow End Date</label>
                <input asp-for="EstimateBorrowEnd" type="date" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label asp-for="IFXBuilding" class="control-label">Building</label>
                <select asp-for="IFXBuilding" asp-items="ViewBag.Buildings" class="form-control" required>
                    <option value="">-- Select Building --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="XrayRooms" class="control-label">X-Ray Room</label>
                <select asp-for="XrayRooms" class="form-control" required>
                    <option value="">-- Select Room --</option>
                </select>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" id="submitButton" disabled />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#validateBadge').click(function () {
                var badge = $('#badgeInput').val();
                if (!badge) {
                    $('#badgeValidationMessage').text('Please enter a badge number');
                    return;
                }

                $.ajax({
                    url: '/Requestors/GetUserDetails',
                    type: 'POST',
                    data: { badge: badge },
                    success: function (data) {
                        if (data.isValid) {
                            $('#Name').val(data.name);
                            $('#Department').val(data.department);
                            $('#RequestorEmail').val(data.email);
                            $('#badgeValidationMessage')
                                .removeClass('text-danger')
                                .addClass('text-success')
                                .text('Badge validated successfully');
                            $('#submitButton').prop('disabled', false);
                        } else {
                            $('#badgeValidationMessage')
                                .removeClass('text-success')
                                .addClass('text-danger')
                                .text('Badge number not found');
                            $('#submitButton').prop('disabled', true);
                            $('#Name').val('');
                            $('#Department').val('');
                            $('#RequestorEmail').val('');
                        }
                    },
                    error: function () {
                        $('#badgeValidationMessage')
                            .removeClass('text-success')
                            .addClass('text-danger')
                            .text('Error validating badge');
                        $('#submitButton').prop('disabled', true);
                        $('#Name').val('');
                        $('#Department').val('');
                        $('#RequestorEmail').val('');
                    }
                });
            });

            $('#IFXBuilding').change(function () {
                var buildingId = $(this).val();
                var roomsDropdown = $('#XrayRooms');
                roomsDropdown.empty().append('<option value="">-- Select Room --</option>');

                if (buildingId) {
                    // Correctly send the GUID as a string
                    $.get('/Requestors/GetXrayRooms?buildingId=' + buildingId, function (data) {
                        $.each(data, function (i, room) {
                            roomsDropdown.append($('<option></option>')
                                .val(room.id) // Use room.id (Guid as string)
                                .text(room.name));
                        });
                    });
                }
            });
        });
    </script>
}